# Copy to .env and fill in local values. NO secrets in the repo (SRS REQ-SEC-01).
# Real values live in the secrets manager; this file documents names only.

# Core services
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=property_intel
POSTGRES_USER=
POSTGRES_PASSWORD=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=property-intel
S3_ACCESS_KEY=
S3_SECRET_KEY=

# App
APP_ENV=development
API_PORT=8000
SECRET_KEY=
LOG_LEVEL=INFO

# Source-system credentials (per connector, SRS REQ-SEC-02).
# Leave blank where the source is public_anonymous — rights gating is in the
# registry, not in these variables.
VOLUSIA_PA_API_KEY=
VOLUSIA_CLERK_REQUEST_CONTACT=
VOLUSIA_PERMITS_API_KEY=
