<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Property workspace{% endblock %} | Property Intel</title>
  {% if has_map %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  {% endif %}
  <style>
    :root {
      --ink:#0f1f2b; --muted:#57687a; --accent:#0e7490; --accent-bright:#06b6d4;
      --line:#dfe6ee; --paper:#fff; --wash:#eef2f6; --amber:#925f0d;
      --dark:#0c1622; --dark-2:#12202f; --dark-line:#22354a;
      --radius:16px; --shadow:0 1px 2px rgba(13,30,44,.05),0 10px 30px -12px rgba(13,30,44,.16);
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--wash); color:var(--ink); font:15px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:var(--accent); text-underline-offset:4px; }
    a:hover { color:#0a5768; }
    button,input,select,textarea { font:inherit; }
    button,a,input,select,textarea,summary { -webkit-tap-highlight-color:transparent; }
    :focus-visible { outline:3px solid #0ea5c4; outline-offset:3px; border-radius:4px; }
    [hidden] { display:none !important; }
    .skip { position:absolute; left:16px; top:-70px; z-index:9999; padding:12px 18px; background:white; border-radius:8px; box-shadow:var(--shadow); }
    .skip:focus { top:10px; }

    /* ---- chrome ---- */
    .topbar { background:linear-gradient(120deg,#0a141f 0%,#0e2433 55%,#0f3040 100%); color:#eaf2f7; border-bottom:1px solid #000; position:sticky; top:0; z-index:1000; }
    .topbar-inner { max-width:1280px; margin:auto; min-height:72px; padding:14px 30px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .brand { color:#fff; font-size:20px; font-weight:760; letter-spacing:-.5px; text-decoration:none; display:flex; align-items:center; gap:12px; }
    .brand:hover { color:#9fe8f4; }
    .brand-mark { display:grid; place-items:center; width:36px; height:36px; border-radius:10px; color:#5eead4;
      background:linear-gradient(145deg,#123243,#0b1f2d); border:1px solid #1e4b5e; box-shadow:inset 0 0 12px #0891b222; }
    .topbar nav { display:flex; align-items:center; gap:20px; }
    .topbar nav a { color:#b9cbd8; text-decoration:none; font-size:14px; font-weight:550; }
    .topbar nav a:hover { color:#fff; }
    .mode { padding:6px 13px; background:#0e749022; border:1px solid #2dd4bf55; border-radius:100px; color:#7ef0dd; font-size:11.5px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; }
    main { max-width:1280px; margin:auto; padding:40px 30px 60px; }

    /* ---- type ---- */
    .eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:2px; font-weight:780; color:var(--accent); margin:0 0 8px; }
    h1,h2,h3,p { margin-top:0; }
    h1 { font-size:clamp(28px,3.6vw,42px); line-height:1.15; letter-spacing:-1.4px; margin-bottom:12px; }
    h2 { font-size:21px; line-height:1.3; letter-spacing:-.5px; margin-bottom:10px; }
    h3 { font-size:15.5px; margin-bottom:8px; }
    p { margin-bottom:14px; }
    .muted,.sub { color:var(--muted); }
    .sub { max-width:660px; font-size:16.5px; }
    .small { font-size:13px; }
    .mono { font-family:ui-monospace,"Cascadia Mono",Consolas,monospace; font-size:.92em; }

    /* ---- layout ---- */
    .hero { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; margin-bottom:26px; }
    .row { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .between { justify-content:space-between; }
    .grid { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(280px,1fr); gap:24px; align-items:start; }

    /* ---- cards ---- */
    .card { background:var(--paper); border:1px solid var(--line); border-radius:var(--radius); padding:26px; box-shadow:var(--shadow); margin-bottom:24px; min-width:0; }
    .card-head { display:flex; justify-content:space-between; align-items:flex-start; gap:15px; margin-bottom:20px; }
    .card-head p { margin:0; }

    /* ---- notices ---- */
    .notice { display:flex; align-items:flex-start; gap:16px; border-radius:14px; padding:18px 22px; margin:0 0 26px;
      background:linear-gradient(120deg,#eef9fb,#f0f7f3); border:1px solid #bfe3e8; }
    .notice p { margin:0; }
    .notice-label { white-space:nowrap; font-size:11px; font-weight:800; letter-spacing:1px; color:#0c5e73; padding-top:3px; }
    .error,.warning { background:#fff8ea; border:1px solid #ecd6a0; border-left:4px solid #d9a33c; border-radius:10px; padding:16px 20px; color:#6b4c12; margin-bottom:20px; font-size:14px; }
    .error p:last-child,.warning p:last-child { margin:0; }

    /* ---- metrics ---- */
    .metrics { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--line); border-radius:14px; background:white; margin:24px 0; box-shadow:var(--shadow); overflow:hidden; }
    .metric { padding:20px 26px; border-right:1px solid var(--line); background:linear-gradient(180deg,#fff, #f8fafc); }
    .metric:last-child { border-right:0; }
    .metric strong { display:block; font-size:30px; font-weight:700; line-height:1.3; letter-spacing:-.6px;
      background:linear-gradient(90deg,#0f1f2b,#0e7490); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .metric span { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.8px; }

    /* ---- badges ---- */
    .badge { display:inline-flex; align-items:center; gap:7px; padding:5px 12px; border-radius:100px; color:#3b5566; background:#eef3f7; font-size:12px; line-height:1.5; font-weight:650; white-space:nowrap; }
    .badge::before { content:""; width:7px; height:7px; border-radius:50%; background:#94a8b8; flex:none; }
    .badge.published,.badge.auto_publish { color:#0c6b44; background:#e2f5ea; }
    .badge.published::before,.badge.auto_publish::before { background:#22b573; }
    .badge.failed,.badge.blocked,.badge.human_review,.badge.awaiting_customer_input { color:#86580a; background:#fdeecb; }
    .badge.failed::before,.badge.blocked::before,.badge.human_review::before,.badge.awaiting_customer_input::before { background:#e2a52f; }

    /* ---- buttons ---- */
    .button,button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:10px 20px; border:1px solid transparent; border-radius:10px;
      background:linear-gradient(135deg,#0e7490,#0c8da8); color:white; font-size:14px; font-weight:650; text-decoration:none; cursor:pointer; transition:transform .12s,box-shadow .12s,filter .12s; box-shadow:0 4px 12px -4px #0e749055; }
    .button:hover,button:hover { color:#fff; filter:brightness(1.08); transform:translateY(-1px); box-shadow:0 8px 18px -6px #0e749066; }
    .button:active,button:active { transform:translateY(0); }
    .button.secondary { background:#fff; color:var(--accent); border-color:#cbd8e2; box-shadow:none; }
    .button.secondary:hover { color:var(--accent); background:#f0f6f9; filter:none; }
    .button.full { width:100%; }
    .actions { display:flex; flex-wrap:wrap; gap:10px; margin:18px 0 0; }

    /* ---- forms ---- */
    label { display:block; font-size:13px; font-weight:650; margin-bottom:7px; }
    input,select,textarea { width:100%; border:1px solid #bcccd9; border-radius:10px; background:#fbfdfe; color:var(--ink); padding:12px 14px; min-height:46px; transition:border-color .15s,box-shadow .15s; }
    input:focus,select:focus,textarea:focus { outline:none; border-color:var(--accent-bright); box-shadow:0 0 0 4px #06b6d422; background:#fff; }
    textarea { resize:vertical; min-height:96px; font-family:ui-monospace,Consolas,monospace; font-size:13px; }
    input::placeholder,textarea::placeholder { color:#7d8fa0; }
    .field { margin-bottom:18px; }
    .field-row { display:grid; grid-template-columns:3fr 1fr; gap:16px; }
    .hint { display:block; margin:7px 0 0; color:var(--muted); font-size:12px; }
    fieldset { border:0; margin:0; padding:0; min-width:0; }

    /* ---- samples / lists ---- */
    .sample { padding:15px 0; border-bottom:1px solid var(--line); }
    .sample:last-child { border-bottom:0; }
    .sample a { font-weight:650; }
    .sample p { font-size:13px; color:var(--muted); margin:5px 0 0; }

    /* ---- tables ---- */
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    th { text-align:left; font-size:11px; letter-spacing:1px; text-transform:uppercase; color:var(--muted); font-weight:700; background:#f5f8fb; }
    td,th { padding:14px 14px; border-bottom:1px solid var(--line); vertical-align:middle; }
    tbody tr { transition:background .12s; }
    tbody tr:hover { background:#f4f9fc; }
    tr:last-child td { border-bottom:0; }
    td a { font-weight:650; }
    td .small { display:block; }

    .empty { padding:30px 20px; text-align:center; border:1.5px dashed #c3d2de; border-radius:14px; background:#f7fafc; }
    .empty p { color:var(--muted); max-width:520px; margin:10px auto 0; }

    /* ---- recovery / steps ---- */
    .recovery { border-top:4px solid #d9a33c; }
    .recovery h2 { font-size:25px; }
    .steps { display:grid; grid-template-columns:repeat(4,1fr); padding:0; list-style:none; gap:12px; margin:0 0 28px; }
    .steps li { border-top:3px solid #d8e2ea; padding-top:12px; color:var(--muted); font-size:13px; }
    .steps .complete { border-color:#14b8a6; color:#0b6b52; }
    .steps .complete strong { color:#0d9488; }
    .steps strong { display:block; font-size:11px; letter-spacing:1.4px; margin-bottom:4px; color:#94a8b8; }

    /* ---- facts / findings ---- */
    .facts { margin:0; }
    .facts div { padding:12px 0; border-bottom:1px solid var(--line); }
    .facts div:last-child { border-bottom:0; }
    .facts dt { font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.7px; }
    .facts dd { margin:4px 0 0; font-weight:600; overflow-wrap:anywhere; }
    .finding { border-top:1px solid var(--line); padding:20px 0 4px; }
    .finding:first-of-type { border-top:0; padding-top:4px; }
    .finding p { font-size:14px; }
    .finding .source { font-size:12px; color:var(--muted); font-family:ui-monospace,Consolas,monospace; }
    details { border-top:1px solid var(--line); padding:16px 0 0; margin-top:14px; }
    summary { cursor:pointer; font-weight:650; font-size:13.5px; color:var(--accent); }
    .timeline { padding-left:22px; color:var(--muted); font-size:13px; }
    .timeline li { padding:7px 0; }
    .timeline time { display:block; font-size:12px; }

    /* ---- map ---- */
    .map-shell { position:relative; border-radius:14px; overflow:hidden; border:1px solid var(--dark-line); margin-top:14px; background:var(--dark); }
    #map { height:520px; background:var(--dark); }
    #map.sample-crs { background:radial-gradient(circle at 30% 20%, #14273a 0%, #0c1622 70%); }
    .map-status { font-size:12.5px; color:var(--muted); margin:12px 2px 0; font-family:ui-monospace,Consolas,monospace; }
    .map-note { display:inline-flex; align-items:center; gap:8px; margin-top:12px; padding:7px 14px; border-radius:100px; font-size:12px; font-weight:650;
      background:#10202f; color:#7ef0dd; border:1px solid #22354a; }
    .leaflet-container { font:12.5px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; }
    .leaflet-control-layers,.leaflet-bar a { border:1px solid var(--dark-line) !important; box-shadow:0 6px 18px rgba(5,12,20,.45) !important; }
    .leaflet-control-layers { background:#12202ff2 !important; color:#dce8f2 !important; border-radius:10px !important; padding:6px 10px; backdrop-filter:blur(6px); }
    .leaflet-control-layers-selector { vertical-align:middle; margin-right:5px; }
    .leaflet-bar a { background:#12202f !important; color:#cfe3ef !important; border-color:#22354a !important; }
    .leaflet-bar a:hover { background:#1b3146 !important; color:#fff !important; }
    .map-tools { display:flex; flex-direction:column; gap:6px; }
    .map-tools button { min-height:0; width:34px; height:34px; padding:0; border-radius:8px; background:#12202f; border:1px solid #22354a; color:#cfe3ef; font-size:16px; box-shadow:0 4px 10px rgba(5,12,20,.4); }
    .map-tools button:hover { background:#1b3146; color:#fff; transform:none; filter:none; }
    .map-tools button.active { background:#0e7490; color:#fff; border-color:#2dd4bf; }
    .map-readout,.map-legend { background:#12202fee; color:#cfe3ef; border:1px solid #22354a; border-radius:9px; padding:6px 11px; font-size:11.5px; font-family:ui-monospace,Consolas,monospace; backdrop-filter:blur(6px); }
    .map-legend { font-family:inherit; line-height:1.9; min-width:130px; }
    .map-legend .swatch { display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:7px; vertical-align:-1px; }
    .map-legend .legend-title { font-size:10px; letter-spacing:1.2px; text-transform:uppercase; color:#7e93a8; display:block; margin-bottom:2px; }
    .grid-label { color:#3d5a73; font:10px ui-monospace,Consolas,monospace; white-space:nowrap; }
    .leaflet-popup-content-wrapper { background:#12202f; color:#dce8f2; border-radius:12px; border:1px solid #2a4157; box-shadow:0 12px 30px rgba(5,12,20,.5); }
    .leaflet-popup-tip { background:#12202f; border:1px solid #2a4157; }
    .leaflet-popup-content { margin:13px 17px; font-size:13px; line-height:1.6; }
    .leaflet-popup-content .pop-title { font-weight:700; color:#fff; font-size:13.5px; display:block; margin-bottom:4px; }
    .leaflet-popup-content .pop-meta { color:#8fa8bc; font-size:11.5px; font-family:ui-monospace,Consolas,monospace; }
    .leaflet-popup-content .pop-status { display:inline-block; margin-top:6px; padding:2px 9px; border-radius:100px; font-size:11px; font-weight:650; background:#1b3146; color:#7ef0dd; }
    .leaflet-popup-close-button { color:#8fa8bc !important; }
    .measure-path { filter:drop-shadow(0 0 4px #06b6d4); }

    footer { max-width:1280px; margin:auto; border-top:1px solid var(--line); padding:26px 30px 38px; color:var(--muted); font-size:12px; }
    footer p { max-width:950px; }

    @media(max-width:840px) {
      .grid { grid-template-columns:1fr; } main { padding:26px 18px; } .topbar-inner { padding:14px 18px; }
      .card { padding:20px; } .hero { flex-direction:column; gap:10px; } .notice { flex-direction:column; gap:5px; }
      .topbar nav a { display:none; } .metric { padding:15px; } .metric strong { font-size:24px; }
      #map { height:380px; }
    }
    @media(max-width:460px) { .field-row { grid-template-columns:1fr; gap:0; } .steps { gap:6px; } .steps li { font-size:11px; } .brand { font-size:17px; } .mode { font-size:9.5px; } td,th { padding:12px 8px; } #map { height:320px; } }
    @media(prefers-reduced-motion:reduce) { * { transition:none !important; scroll-behavior:auto !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/portal?account={{ account | urlencode }}">
        <span class="brand-mark" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 7l6-3 6 3 6-3v14l-6 3-6-3-6 3V7zM9 4v14M15 7v14" stroke="currentColor" stroke-width="1.4"/></svg></span>
        Property Intel
      </a>
      <nav aria-label="Main navigation"><a href="/portal?account={{ account | urlencode }}">Workspace</a><span class="mode">{{ "Sample data workspace" if demo_mode else "Development workspace" }}</span></nav>
    </div>
  </header>
  <main id="main">{% block content %}{% endblock %}</main>
  <footer><p><strong>Evidence-led screening. Not a professional determination.</strong></p><p>{{ boundary_statement }}</p><p>Development preview &middot; Account selection is not authentication. Do not use for customer decisions.</p></footer>
</body>
</html>
