<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Property workspace{% endblock %} | Property Intel</title>
  {% if has_map %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  {% endif %}
  <style>
    :root { --ink:#193730; --muted:#536961; --accent:#24634d; --line:#dce4dc; --paper:#fff; --wash:#f3f5f0; --amber:#855b12; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--wash); color:var(--ink); font:15px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:var(--accent); text-underline-offset:4px; }
    button,input,select,textarea { font:inherit; }
    button,a,input,select,textarea,summary { -webkit-tap-highlight-color:transparent; }
    :focus-visible { outline:3px solid #bb861e; outline-offset:4px; }
    [hidden] { display:none !important; }
    .skip { position:absolute; left:16px; top:-70px; z-index:9999; padding:12px; background:white; }
    .skip:focus { top:10px; }
    .topbar { background:#16372f; color:#fff; }
    .topbar-inner { max-width:1240px; margin:auto; min-height:78px; padding:16px 30px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .brand { color:white; font-size:21px; font-weight:750; letter-spacing:-.6px; text-decoration:none; display:flex; align-items:center; gap:12px; }
    .brand-mark { display:grid; place-items:center; width:35px; height:35px; border:1px solid #87b7a1; border-radius:9px; }
    .topbar nav { display:flex; align-items:center; gap:22px; }
    .topbar nav a { color:#e3ece4; text-decoration:none; font-size:14px; }
    .mode { padding:5px 12px; background:#2e4d40; border:1px solid #688675; border-radius:100px; color:#f3e3b5; font-size:12px; font-weight:650; }
    main { max-width:1240px; margin:auto; padding:38px 30px 55px; }
    .eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:1.8px; font-weight:750; color:var(--muted); margin:0 0 10px; }
    h1,h2,h3,p { margin-top:0; }
    h1 { font-size:clamp(27px,3.5vw,40px); line-height:1.2; letter-spacing:-1.3px; margin-bottom:12px; }
    h2 { font-size:22px; line-height:1.3; letter-spacing:-.5px; margin-bottom:12px; }
    h3 { font-size:16px; margin-bottom:8px; }
    p { margin-bottom:14px; }
    .muted,.sub { color:var(--muted); }
    .sub { max-width:680px; font-size:16px; }
    .small { font-size:13px; }
    .hero { display:flex; justify-content:space-between; align-items:start; gap:24px; margin-bottom:26px; }
    .row { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .between { justify-content:space-between; }
    .grid { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(270px,1fr); gap:24px; align-items:start; }
    .card { background:var(--paper); border:1px solid var(--line); border-radius:15px; padding:26px; box-shadow:0 3px 12px #19373004; margin-bottom:24px; min-width:0; }
    .card-head { display:flex; justify-content:space-between; align-items:start; gap:15px; margin-bottom:20px; }
    .card-head p { margin:0; }
    .notice { display:flex; align-items:start; gap:15px; background:#e8eee3; border:1px solid #ccd9c4; border-radius:12px; padding:17px 22px; margin:0 0 26px; }
    .notice p { margin:0; }
    .notice-label { white-space:nowrap; font-size:12px; font-weight:750; color:#375535; padding-top:3px; }
    .error,.warning { background:#fff6e5; border:1px solid #eed5a3; border-radius:12px; padding:19px 22px; color:#684914; margin-bottom:22px; }
    .error p:last-child,.warning p:last-child { margin:0; }
    .metrics { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--line); border-radius:12px; background:white; margin:24px 0; }
    .metric { padding:18px 24px; border-right:1px solid var(--line); }
    .metric:last-child { border-right:0; }
    .metric strong { display:block; font-size:27px; font-weight:650; line-height:1.4; }
    .metric span { color:var(--muted); font-size:12px; }
    .badge { display:inline-flex; padding:5px 11px; border-radius:100px; color:#3c584e; background:#edf2ed; font-size:12px; line-height:1.5; font-weight:650; white-space:nowrap; }
    .badge.published,.badge.auto_publish { color:#215c3f; background:#e4f1e6; }
    .badge.failed,.badge.blocked,.badge.human_review,.badge.awaiting_customer_input { color:#7b5713; background:#fff0cf; }
    .button,button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:10px 18px; border:1px solid var(--accent); border-radius:8px; background:var(--accent); color:white; font-size:14px; font-weight:650; text-decoration:none; cursor:pointer; transition:background .15s; }
    .button:hover,button:hover { background:#194d39; }
    .button.secondary { background:white; color:var(--accent); border-color:#c6d5c9; }
    .button.secondary:hover { background:#eef3ed; }
    .button.full { width:100%; }
    .actions { display:flex; flex-wrap:wrap; gap:10px; margin:18px 0 0; }
    label { display:block; font-size:13px; font-weight:650; margin-bottom:7px; }
    input,select,textarea { width:100%; border:1px solid #b8c9be; border-radius:8px; background:white; color:var(--ink); padding:12px 13px; min-height:46px; }
    textarea { resize:vertical; min-height:95px; }
    input::placeholder,textarea::placeholder { color:#74857b; }
    .field { margin-bottom:18px; }
    .field-row { display:grid; grid-template-columns:3fr 1fr; gap:16px; }
    .hint { display:block; margin:7px 0 0; color:var(--muted); font-size:12px; }
    fieldset { border:0; margin:0; padding:0; min-width:0; }
    .sample { padding:14px 0; border-bottom:1px solid var(--line); }
    .sample:last-child { border-bottom:0; }
    .sample a { font-weight:650; }
    .sample p { font-size:13px; color:var(--muted); margin:5px 0 0; }
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    th { text-align:left; font-size:11px; letter-spacing:.8px; text-transform:uppercase; color:var(--muted); font-weight:650; background:#f7f9f5; }
    td,th { padding:14px 12px; border-bottom:1px solid var(--line); vertical-align:middle; }
    tr:last-child td { border-bottom:0; }
    td a { font-weight:650; }
    td .small { display:block; }
    .empty { padding:26px 18px; text-align:center; border:1px dashed #c6d5c9; border-radius:12px; background:#f8faf6; }
    .empty p { color:var(--muted); max-width:520px; margin:10px auto 0; }
    .recovery { border-top:4px solid #c49a43; }
    .recovery h2 { font-size:26px; }
    .steps { display:grid; grid-template-columns:repeat(4,1fr); padding:0; list-style:none; gap:12px; margin:0 0 28px; }
    .steps li { border-top:3px solid #d5dfd5; padding-top:12px; color:var(--muted); font-size:13px; }
    .steps .complete { border-color:#4e8461; color:#26563c; }
    .steps strong { display:block; font-size:11px; letter-spacing:1px; margin-bottom:4px; }
    .facts { margin:0; }
    .facts div { padding:13px 0; border-bottom:1px solid var(--line); }
    .facts dt { font-size:12px; color:var(--muted); }
    .facts dd { margin:3px 0 0; font-weight:600; overflow-wrap:anywhere; }
    .finding { border-top:1px solid var(--line); padding:19px 0 3px; }
    .finding:first-of-type { border-top:0; }
    .finding p { font-size:14px; }
    .finding .source { font-size:12px; color:var(--muted); }
    details { border-top:1px solid var(--line); padding:18px 0 0; margin-top:16px; }
    summary { cursor:pointer; font-weight:650; font-size:13px; }
    .timeline { padding-left:22px; color:var(--muted); font-size:13px; }
    .timeline li { padding:8px 0; }
    .timeline time { display:block; font-size:12px; }
    #map { height:360px; border-radius:10px; border:1px solid var(--line); margin-top:14px; }
    .map-status { font-size:13px; color:var(--muted); margin-top:12px; }
    footer { max-width:1240px; margin:auto; border-top:1px solid var(--line); padding:25px 30px 36px; color:var(--muted); font-size:12px; }
    footer p { max-width:950px; }
    @media(max-width:800px) { .grid { grid-template-columns:1fr; } main { padding:26px 18px; } .topbar-inner { padding:16px 18px; } .card { padding:20px; } .hero { flex-direction:column; gap:10px; } .notice { flex-direction:column; gap:5px; } .topbar nav a { display:none; } .metric { padding:14px; } }
    @media(max-width:450px) { .field-row { grid-template-columns:1fr; gap:0; } .steps { gap:6px; } .steps li { font-size:11px; } .brand { font-size:18px; } .mode { font-size:10px; } td,th { padding:12px 8px; } }
    @media(prefers-reduced-motion:reduce) { * { transition:none !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/portal?account={{ account | urlencode }}">
        <span class="brand-mark" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none"><path d="M3 7l6-3 6 3 6-3v14l-6 3-6-3-6 3V7zM9 4v14M15 7v14" stroke="currentColor" stroke-width="1.4"/></svg></span>
        Property Intel
      </a>
      <nav aria-label="Main navigation"><a href="/portal?account={{ account | urlencode }}">Workspace</a><span class="mode">{{ "Sample data workspace" if demo_mode else "Development workspace" }}</span></nav>
    </div>
  </header>
  <main id="main">{% block content %}{% endblock %}</main>
  <footer><p><strong>Evidence-led screening. Not a professional determination.</strong></p><p>{{ boundary_statement }}</p><p>Development preview &middot; Account selection is not authentication. Do not use for customer decisions.</p></footer>
</body>
</html>
